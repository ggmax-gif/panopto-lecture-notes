# Which browser yt-dlp borrows Panopto session cookies from.
# chrome | brave | firefox | safari | edge | chromium | vivaldi
# Use "chrome:Profile 1" to pick a specific profile.
browser: chrome

# Folders and one-off lectures to sync.
# Folder URLs look like:
#   https://recapexeter.cloud.panopto.eu/Panopto/Pages/Sessions/List.aspx?folderID=<uuid>
# Single lectures look like:
#   https://recapexeter.cloud.panopto.eu/Panopto/Pages/Viewer.aspx?id=<uuid>
# Leave `name` off a folder and each lecture files itself by the module code in
# its own title — a Recap folder is usually a mixed archive, not one module.
sources:
  # - url: "https://recapexeter.cloud.panopto.eu/Panopto/Pages/Sessions/List.aspx#folderID=%22<your-folder-uuid>%22"

# How many of the newest recordings `autosync` checks per source each run. The
# folder above holds 131; new ones land at the top, so there's no point walking
# the lot every week.
autosync_check: 20

# Panopto offers three kinds of stream:
#   DV       camera + slides tiled into quadrants, with audio (~470 MB / 2 hours)
#   OBJECT   the slides alone, full frame, no audio           (~160 MB / 2 hours)
#   PODCAST  Panopto's own merged download
# OBJECT is the one worth having: in DV the slide is squashed into a quarter of
# the frame, which reads badly to a vision model.
# Slides come from the screen capture and the transcript comes from Panopto's
# captions, so by default we only download OBJECT — a tenth of the size.
video_format: "bv*[acodec=none]/b"

# Only used when a recording has no captions and Whisper has to run: the
# screen-only stream has no audio, so the smallest audio-bearing stream is
# fetched separately.
audio_format: "worst[acodec!=none]/ba/b"

# Local transcription, used only when Panopto has no captions.
whisper_model: "mlx-community/whisper-large-v3-turbo"

# Slide detection. Higher threshold = fewer keyframes. If a lecture produces
# more than max_slides, the threshold is raised automatically and retried.
slide_threshold: 0.15
max_slides: 60

# Frames per second fed to the scene detector. It scores each frame against the
# one before it, so at a video's own 25 fps it is being asked whether 1/25th of a
# second changed anything — and a slide that cross-fades over half a second is
# 25 changes too small to notice, so it goes missing. Two a second puts the whole
# transition between one comparison and the next, and scans a 1080p lecture about
# 3x faster into the bargain. Set 0 to score every frame, as this used to.
scene_scan_fps: 2

# Slide transitions cross-fade, which fires the scene detector several times per
# change. Keyframes closer together than this (seconds) are collapsed to one.
min_slide_gap: 2.0

# Read each slide with Apple's Vision framework and inline the text into
# bundle.md. This is what lets a text-only local model see equations and tables,
# and it gives a much better duplicate test than timing alone.
#   pip install pyobjc-framework-Vision
ocr: true

# Consecutive slides whose OCR text overlaps by at least this much are treated
# as one animated build; the last (most complete) is kept.
slide_text_similarity: 0.90

# Delete the recording once slides and transcript are extracted: ~148 MB
# becomes ~5 MB per lecture, so a term fits in a few hundred MB instead of
# several GB. Nothing the notes rely on is lost — slides are images on disk,
# the transcript is text, and every timestamp links back into Panopto for the
# moments you want to hear. The viewer opens Panopto instead of playing
# locally. Set true to keep recordings for offline playback.
keep_video: false

# How `analyse` gets its notes written.
#
#   backend: openai      any OpenAI-compatible endpoint (local Ollama, LM Studio,
#                        vllm-mlx, or the metered Gemini API)
#   backend: antigravity shells out to Antigravity's CLI (`agy -p`), which does
#                        still spend the subscription. Needs `agy` on PATH and
#                        signed in, and a model from `agy models` rather than a
#                        local tag. endpoint and max_context_tokens are ignored.
#
# Ollama is already running locally and needs no key, so it's the default.
backend: "openai"

# antigravity only: let the model open the slide JPEGs instead of reading only
# the text OCR pulled off them. OCR is what flattens an equation or a table into
# nonsense, so this is worth it on the maths-heavy modules and pointless on the
# ones whose slides are prose. It costs a few tool round trips per lecture, and
# forces bundle.md as the source since transcript.md names no slides.
# `--vision` turns it on for one run.
#
# It also works on the openai backend with a local model that can see, which
# the default qwen3.8:27b-mlx is — so `--vision` needs no second model. The
# gemma4 line and nemotron are text-only; `ollama show <model>` says which. That path sends the images itself rather
# than letting an agent open them, so it costs context: vision_slides is how
# many go, densest-in-figures first, charged at ~1200 tokens each against
# max_context_tokens and taken out of the transcript's share.
vision: false
vision_slides: 6

# Seconds to wait for a completion. Large local models take far longer than the
# client's 600s default on a two-hour lecture — leave this generous.
request_timeout: 3600

# Fallback context window, and how much of it to leave free for the reply.
# Bundles larger than the remainder are trimmed before sending — a slide-heavy
# lecture can produce 33k tokens, and Ollama doesn't reject an overlong request,
# it just drops the oldest tokens, which is the start of the transcript.
#
# Against Ollama this number is only a fallback: analyse asks /api/ps what window
# is actually being served and budgets against that, so the two can't drift. The
# window is a server setting and can't be requested per call — the OpenAI
# compatibility layer drops `options` — so to widen it:
#
#   launchctl setenv OLLAMA_CONTEXT_LENGTH 65536   # then restart Ollama
#
# Worth doing: on BEF2014, sending the bundle whole into 65,536 rather than
# trimming it into 32,768 cited 93 figures against 47, at 2 unsupported against
# 0, with better quote fidelity — for about five minutes more per lecture, and
# 22 GB resident rather than 18.
max_context_tokens: 32768
reserve_output_tokens: 3000
endpoint: "http://localhost:11434/v1"
model: "gemma4:12b-mlx"

# 12B is a safe default rather than the best one — it's what fits everywhere.
# On a 32 GB Mac, measured on one lecture with the same prompt:
#
#   model                     wall   prefill    gen   notes   quotes/wrong
#   gemma4:12b-mlx            448s   116 t/s   20.3   9.4 KB     12 / 1
#   gemma4:26b-mlx            207s   318 t/s   27.0   4.9 KB      9 / 0
#   muse-glimmer:30b-mlx     1614s   202 t/s   10.2  12.0 KB     30 / 0
#   nemotron (untrimmed)      597s   880 t/s   36.1  15.7 KB     44 / 2
#   ---- same trimmed input ----
#   qwen3.8:27b-mlx           661s   182 t/s   13.7  22.4 KB    102 / 6
#   nemotron-3.5-lightning   1467s   486 t/s   37.2  11.8 KB     52 / 8
#
# qwen3.8:27b-mlx is what this machine runs: on the same input it is 2.2x
# faster than nemotron for 1.9x the notes, and it reads slide images too, so
# `vision: true` needs no second model. Note the lowest raw generation rate
# here still delivers the most notes — what matters is how much of the
# generation is reasoning the model then throws away.
#
# Other combinations, swap in as needed:
#   NOT qwen3.6:27b-mlx on 32 GB — 19 GB of weights plus a 32k KV cache
#   overcommits and it thrashes: measured 0.3 tok/s generation, i.e. ~3 hours
#   for one lecture instead of minutes. Size alone doesn't decide it — the
#   30B mixture-of-experts above is bigger and fine — so measure, don't guess.
#   LM Studio               endpoint: "http://localhost:1234/v1"
#   Subscription Gemini     backend: "antigravity"  model: "gemini-3.1-pro-high"
#                           (endpoint and max_context_tokens are ignored)
#   Metered Gemini API      endpoint: "https://generativelanguage.googleapis.com/v1beta/openai/"
#                           model: "gemini-2.5-pro"  + export GEMINI_API_KEY

# Port the `serve` daemon listens on (loopback only).
port: 8420

# Where `export` writes notes. Lectures land in <vault>/<folder>/<Module>/, with
# slide images in <vault>/<folder>/attachments/ under vault-unique names.
obsidian_vault: ""   # e.g. "/Users/you/Documents/My Vault"
obsidian_folder: "Lectures"
