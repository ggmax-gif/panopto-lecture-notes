{
  "manifest_version": 3,
  "name": "Lecture Notes",
  "version": "1.0",
  "description": "Send the Panopto lecture you're watching to your local pipeline, and get notes back.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.panopto.eu/Panopto/Pages/Viewer.aspx*",
        "https://*.panopto.com/Panopto/Pages/Viewer.aspx*"
      ],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
